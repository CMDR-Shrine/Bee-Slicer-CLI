# BEETHEFIRST 3D Printer USB permissions
# This file allows users in Arch Linux's 'uucp' group to access BEETHEFIRST printers

# BEETHEFIRST original (Vendor ID 0xFFFF)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="ffff", ATTR{idProduct}=="014e", MODE="0660", GROUP="uucp"

# BEETHEFIRST+ (Vendor ID 0x29C9)
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="29c9", MODE="0660", GROUP="uucp"
